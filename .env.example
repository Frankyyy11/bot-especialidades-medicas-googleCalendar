# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.

# --- Servidor ---
PORT=3000
# debug | info | warn | error  (en info no se registra el contenido de los mensajes)
LOG_LEVEL=info
# Ruta de la configuración del centro (relativa a la carpeta desde donde se arranca)
CLINIC_CONFIG_PATH=config/centro.json

# --- Agenda ---
# google = Google Calendar (provisional) | memory = en memoria (pruebas, se pierde al reiniciar) | siku = pendiente
AGENDA_PROVIDER=memory
# recepcion = la cita queda "por confirmar" y recepción la valida | auto = se informa como confirmada
CONFIRMATION_MODE=recepcion

# --- Google Calendar (solo si AGENDA_PROVIDER=google). Use UNA de las dos opciones ---
# Ruta al JSON de la cuenta de servicio (fuera del repo)
GOOGLE_SERVICE_ACCOUNT_FILE=
# o el contenido completo del JSON en una sola línea
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- WhatsApp Cloud API (Meta) ---
# Token que usted inventa; se escribe igual en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# "Secreto de la app" (App Secret) de Meta; se usa para validar la firma X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Token de acceso permanente (usuario del sistema)
WHATSAPP_ACCESS_TOKEN=
# Id del número de teléfono (Phone Number ID) en Meta
WHATSAPP_PHONE_NUMBER_ID=
# Versión de Graph API. El valor por defecto es solo un punto de partida: revise la vigente en la documentación de Meta
WHATSAPP_API_VERSION=v23.0

# --- Capa de IA (opcional; ver docs/IA.md) ---
# none = sin IA, solo menús y palabras clave (por defecto) | gemini = API de Gemini | fake = simulada (pruebas y simulador)
AI_PROVIDER=none
# Solo con AI_PROVIDER=gemini. Cree la key en Google AI Studio. NUNCA la suba al repositorio.
# Con pacientes reales use un proyecto con facturación habilitada (el nivel gratuito puede usar los mensajes para mejorar productos de Google).
GEMINI_API_KEY=
# Obligatoria con AI_PROVIDER=gemini y SIN valor por defecto (los modelos cambian seguido). Cómo listarlos: docs/IA.md
GEMINI_MODEL=
# Opcional, sin valor por defecto. Nivel de razonamiento: minimal | low | medium | high (depende del modelo; ver docs/IA.md).
# Vacío = el nivel por defecto del modelo. Un nivel que el modelo no admite hace fallar cada llamada (el bot sigue con reglas).
GEMINI_THINKING_LEVEL=
# Tiempo máximo (ms) por intento de llamada a la IA; si se agota, el bot sigue solo con reglas
AI_TIMEOUT_MS=6000
# Máximo de llamadas a la IA por teléfono por día (controla costo y abuso)
AI_MAX_CALLS_PER_PHONE_PER_DAY=40

# --- Comportamiento ---
# Minutos que el bot se pausa en una conversación cuando recepción responde a mano o se pide recepción
HUMAN_PAUSE_MINUTES=120
# Minutos de inactividad tras los cuales se descarta la sesión
SESSION_TTL_MINUTES=30
# Máximo de mensajes por minuto por teléfono
RATE_LIMIT_PER_MINUTE=20
